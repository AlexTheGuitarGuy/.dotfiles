#!/usr/bin/env python3
import json
import os
import subprocess

SOPS = subprocess.run(["which", "sops"], capture_output=True, text=True).stdout.strip() \
    or "/home/linuxbrew/.linuxbrew/bin/sops"
import glob

SECRETS_FILES = [os.path.expanduser("~/.dotfiles/secrets/secrets.yaml")] + \
    sorted(glob.glob(os.path.expanduser("~/.config/secrets.d/*.yaml")))
KEYS_DIR = os.path.expanduser("~/.ssh/keys")

os.makedirs(KEYS_DIR, exist_ok=True)
os.chmod(os.path.expanduser("~/.ssh"), 0o700)
os.chmod(KEYS_DIR, 0o700)

data = {}
for secrets_file in SECRETS_FILES:
    decrypted = subprocess.run(
        [SOPS, "-d", "--output-type", "json", secrets_file],
        capture_output=True, text=True, check=True,
    ).stdout
    data.update(json.loads(decrypted))

for secret_name, value in data.items():
    if not secret_name.startswith("SSH_KEY_") or not value:
        continue
    file_name = secret_name.removeprefix("SSH_KEY_").lower().replace("_", "-")
    path = os.path.join(KEYS_DIR, file_name)
    with open(path, "w") as f:
        f.write(value)
    os.chmod(path, 0o600)
