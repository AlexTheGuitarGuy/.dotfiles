#!/bin/sh
# tgs-equivalent for herdr: fuzzy-pick a project into a herdr workspace
# (via the salkhalil/herdr-sessionizer plugin), then attach the herdr TUI
# when run from a plain shell.
#
#   tzt            interactive picker
#   tzt <dir>      skip the picker, switch/create directly

set -eu

HERDR="${HERDR_BIN_PATH:-herdr}"
command -v herdr >/dev/null 2>&1 || HERDR="$HOME/.local/bin/herdr"

root=$("$HERDR" plugin list --json 2>/dev/null \
    | jq -r '.result.plugins[] | select(.plugin_id == "sessionizer") | .plugin_root')

if [ -z "${root:-}" ] || [ ! -x "$root/bin/sessionizer" ]; then
    echo "tzt: sessionizer plugin not installed" >&2
    echo "     herdr plugin install salkhalil/herdr-sessionizer -y" >&2
    exit 1
fi

"$root/bin/sessionizer" "$@"

[ -n "${HERDR_ENV:-}" ] && exit 0
exec "$HERDR"
