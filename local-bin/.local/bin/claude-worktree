#!/usr/bin/env bash
set -euo pipefail

input="$(cat)"
field() { jq -r --arg k "$1" '.[$k] // empty' <<<"$input"; }

case "${1:-}" in
  create)
    name="$(field name)"
    cwd="$(field cwd)"
    common="$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir)"
    if [ "$(basename "$common")" = .bare ]; then
      path="$(dirname "$common")/$name"
    else
      path="$(git -C "$cwd" rev-parse --show-toplevel)/.claude/worktrees/$name"
    fi
    base="$(git -C "$cwd" symbolic-ref --quiet --short refs/remotes/origin/HEAD || echo HEAD)"
    git -C "$cwd" worktree add -b "worktree-$name" "$path" "$base" >&2
    echo "$path"
    ;;
  remove)
    path="$(field worktree_path)"
    keep="$(git -C "$path" status --ignored --porcelain | sed -n 's/^!! //p' | while read -r f; do
      f="${f%/}"
      case "$(basename "$f")" in node_modules|dist|build|coverage|.nx|.turbo|.gitnexus|*.tsbuildinfo) continue;; esac
      [ "$(basename "$f")" = .env ] && [ -L "$path/$f" ] && continue
      if [ "$f" = .excluded ]; then
        find "$path/.excluded" -type f | while read -r x; do
          [ "$x" = "$path/.excluded/todos.txt" ] && [ "$(cat "$x")" = TODOs ] && continue
          echo "${x#"$path/"}"
        done
        continue
      fi
      echo "$f"
    done)"
    if [ -n "$keep" ]; then
      printf 'claude-worktree: %s has ignored files that removing it would delete; move them or remove it by hand:\n%s\n' "$path" "$keep" >&2
      exit 1
    fi
    branch="$(git -C "$path" branch --show-current 2>/dev/null || true)"
    git -C "$path" worktree remove "$path" >&2
    command -v gitnexus >/dev/null && gitnexus remove --force "$path" >/dev/null 2>&1 || true
    case "$branch" in worktree-*) git -C "$(field cwd)" branch -d "$branch" >&2 || true;; esac
    ;;
  *)
    echo "usage: claude-worktree create|remove < hook-input.json" >&2
    exit 2
    ;;
esac
