#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/snap/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
pipe=/tmp/godot-nvim.pipe

setup() {
  local settings
  settings="$(ls -v "$HOME"/.var/app/org.godotengine.Godot/config/godot/editor_settings-4.*.tres | tail -1)"
  if pgrep -f godot-bin >/dev/null; then
    echo "godot-nvim: close Godot first, it rewrites $settings on exit" >&2
    exit 1
  fi
  local flags="--host $HOME/.local/bin/godot-nvim open {project} {file} {line} {col}"
  python3 - "$settings" "$flags" <<'EOF'
import re, sys
path, flags = sys.argv[1], sys.argv[2]
want = {
    'text_editor/external/use_external_editor': 'true',
    'text_editor/external/exec_path': '"flatpak-spawn"',
    'text_editor/external/exec_flags': '"' + flags.replace('"', '\\"') + '"',
}
text = open(path).read()
for key, value in want.items():
    line = f'{key} = {value}'
    pattern = re.compile(rf'^{re.escape(key)} = .*$', re.M)
    text = pattern.sub(lambda _: line, text) if pattern.search(text) else text.rstrip('\n') + f'\n{line}\n'
open(path, 'w').write(text)
EOF
  echo "godot-nvim: external editor set in $settings"
}

herdr_workspace() {
  herdr pane list 2>/dev/null | jq -r --arg p "$1" \
    '[.result.panes[] | select(.cwd == $p or (.cwd | startswith($p + "/")))][0].workspace_id // empty'
}

start_in_herdr() {
  local project="$1" ws out
  ws="$(herdr_workspace "$project")"
  if [ -n "$ws" ]; then
    out="$(herdr tab create --workspace "$ws" --cwd "$project" --label nvim --focus)"
  else
    out="$(herdr workspace create --cwd "$project" --label "$(basename "$project")" --focus)"
  fi
  herdr pane run "$(jq -r '.result.root_pane.pane_id' <<<"$out")" "nvim --listen $pipe" >/dev/null
  pgrep -f '^herdr( |$)' >/dev/null || setsid ghostty -e herdr >/dev/null 2>&1 &
}

focus_terminal() {
  local win="" w
  for _ in $(seq 20); do
    for w in $(xdotool search --onlyvisible --class ghostty 2>/dev/null || true); do
      case "$(xdotool getwindowname "$w" 2>/dev/null)" in *"$1"*) win="$w" ;; esac
    done
    [ -n "$win" ] && break
    sleep 0.2
  done
  [ -n "$win" ] || win="$(xdotool search --onlyvisible --class ghostty 2>/dev/null | tail -1 || true)"
  [ -n "$win" ] || return 0
  for _ in $(seq 8); do
    [ "$(xdotool getactivewindow 2>/dev/null || true)" = "$win" ] || xdotool windowactivate "$win" 2>/dev/null || true
    sleep 0.25
  done
}

open_file() {
  local project="$1" file="$2" line="${3:-1}" col="${4:-1}" herdr_up=""
  command -v herdr >/dev/null && herdr status server 2>/dev/null | grep -q 'status: running' && herdr_up=1
  if nvim --server "$pipe" --remote-expr 1 >/dev/null 2>&1; then
    if [ -n "$herdr_up" ]; then
      ws="$(herdr_workspace "$project")"
      [ -n "$ws" ] && herdr workspace focus "$ws" >/dev/null
    fi
  else
    rm -f "$pipe"
    cd "$project"
    if [ -n "$herdr_up" ]; then
      start_in_herdr "$project"
    else
      setsid ghostty -e nvim --listen "$pipe" >/dev/null 2>&1 &
    fi
    for _ in $(seq 50); do
      nvim --server "$pipe" --remote-expr 1 >/dev/null 2>&1 && break
      sleep 0.2
    done
  fi
  nvim --server "$pipe" --remote "$file"
  nvim --server "$pipe" --remote-send "<C-\\><C-N>:call cursor($line, $col)<CR>"
  setsid "$0" focus "$(basename "$project")" >/dev/null 2>&1 < /dev/null &
}

case "${1:-}" in
  setup) setup ;;
  open) shift; open_file "$@" ;;
  focus) focus_terminal "$2" ;;
  *) echo "usage: godot-nvim setup | open <project> <file> [line] [col]" >&2; exit 2 ;;
esac
