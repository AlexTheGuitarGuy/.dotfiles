{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "caveman-opencode-plugin",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "apiportal": {
      "type": "local",
      "command": ["pnpm", "dlx", "@dvag/apiportal-mcp@1.1.0"],
      "enabled": true
    },
    "lens": {
      "type": "local",
      "command": ["/opt/Lens/resources/cli/bin/lens-cli-linux-x64", "mcp-server"],
      "enabled": true
    }
  },
  "lsp": true
}
