{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "caveman-opencode-plugin",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "REPLACE_WITH_YOUR_OWN_KEY"
      }
    },
    "apiportal": {
      "type": "local",
      "command": ["pnpm", "dlx", "@dvag/apiportal-mcp@1.1.0"],
      "enabled": true
    },
    "lens": {
      "type": "local",
      "command": ["/opt/Lens/resources/cli/bin/lens-cli-linux-x64", "mcp-server"],
      "enabled": true
    }
  },
  "lsp": true
}
