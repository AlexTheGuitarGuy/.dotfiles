[user]
	name = AlexSeremet
	email = seremet.alexandru.work@gmail.com

[includeIf "gitdir:~/projects/DFS/"]
	path = ~/.gitconfig-dvag

[init]
	templatedir = ~/.git-templates

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictstyle = diff3

[pull]
	rebase = true
