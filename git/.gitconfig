[user]
	name = AlexSeremet
	email = seremet.alexandru.work@gmail.com

[core]
	pager = delta
	excludesFile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictstyle = diff3

[pull]
	rebase = true

[hook "gitnexus-worktree"]
	event = post-checkout
	command = ~/.local/bin/worktree-gitnexus

[include]
	path = ~/.gitconfig.private
