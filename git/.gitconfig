[user]
	name = AlexSeremet
	email = seremet.alexandru.work@gmail.com

[core]
	pager = delta
	excludesFile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictstyle = diff3

[pull]
	rebase = true

[hook "todos"]
	event = post-checkout
	command = ~/.local/bin/git-todos

[hook "gitnexus-worktree"]
	event = post-checkout
	command = ~/.local/bin/worktree-gitnexus

[hook "gitnexus-push"]
	event = pre-push
	command = ~/.local/bin/gitnexus-reindex push

[hook "gitnexus-pull"]
	event = post-merge
	event = post-rewrite
	command = ~/.local/bin/gitnexus-reindex pull

[include]
	path = ~/.gitconfig.private
