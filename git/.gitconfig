[user]
	name = AlexSeremet
	email = seremet.alexandru.work@gmail.com

[core]
	pager = delta
	excludesFile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictstyle = diff3

[pull]
	rebase = true

[includeIf "gitdir:~/projects/DFS/"]
	path = ~/.gitconfig-dvag
